{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec serve out --listen 4174 --config ../tests/e2e/serve.json --no-clipboard",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:4174/",
        "http://localhost:4174/story",
        "http://localhost:4174/contact",
        "http://localhost:4174/es",
        "http://localhost:4174/experience/apple-software-project-engineer-2024"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
